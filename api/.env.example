# OpenAI API 키 — 실제 값으로 채운 뒤 api/llm/VoiceProcessing/.env 로 저장
OPENAI_API_KEY=sk-...

# 사용 모델 (기본값을 쓰려면 비워두어도 된다)
COMMAND_MODEL=gpt-5.6-terra          # 자유 대화·명령 해석
ASSEMBLY_VISION_MODEL=gpt-5.6-sol    # 조립 사진 판정
MANUAL_GENERATOR_MODEL=gpt-5.6-terra # PDF -> 조립서 생성
REALTIME_MODEL=gpt-realtime-2.1      # 음성 대화
STT_MODEL=gpt-transcribe             # 음성 인식
TTS_MODEL=gpt-4o-mini-tts            # 음성 합성
