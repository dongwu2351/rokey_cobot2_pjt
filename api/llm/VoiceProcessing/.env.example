OPENAI_API_KEY=your_api_key_here
ASSEMBLY_VISION_MODEL=gpt-5.6
MANUAL_GENERATOR_MODEL=gpt-5.6

# Recommended defaults. Override after measuring representative commands.
STT_MODEL=gpt-transcribe
# Set to local (or hybrid for cloud fallback on local failure).
# STT_BACKEND=local
# LOCAL_STT_MODEL=base
# LOCAL_STT_DEVICE=cpu
# LOCAL_STT_COMPUTE_TYPE=int8
COMMAND_MODEL=gpt-5.6-terra
COMMAND_REASONING_EFFORT=none
COMMAND_TIMEOUT_SECONDS=8.0
# Optional custom system prompt file for free-form voice/vision commands.
# COMMAND_INSTRUCTIONS_FILE=VoiceProcessing/prompts/assistive_system.txt
# Motion is rejected if the vision snapshot is older than this at validation.
COMMAND_MAX_SNAPSHOT_AGE_MS=3000
COMMAND_MAX_FUTURE_SKEW_MS=250

# Short Korean clarification responses. The voice is AI-generated and must be
# disclosed to people who interact with the system.
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=marin

# Omit MIC_DEVICE_INDEX to use the system default input device.
MIC_SAMPLE_RATE=16000
# MIC_DEVICE_INDEX=0
