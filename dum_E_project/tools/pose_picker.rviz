Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Obstacles1
        - /TCPPath1
      Splitter Ratio: 0.5
    Tree Height: 700
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Cell Size: 0.1
      Plane Cell Count: 20
      Color: 90; 90; 90
      Enabled: true
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Description Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /robot_description
      Enabled: true
      Visual Enabled: true
      Collision Enabled: false
      Alpha: 1
    - Class: rviz_default_plugins/MarkerArray
      Name: Obstacles
      Namespaces: {}
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /curobo/obstacles
      Enabled: true
    - Class: rviz_default_plugins/Path
      Name: GlobalPath
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /curobo/global_path
      Enabled: true
      Color: 230; 230; 240
      Line Style: Billboards
      Line Width: 0.006
      Alpha: 0.65
      Buffer Length: 1
      Offset: {X: 0, Y: 0, Z: 0}
      Pose Style: None
    - Class: rviz_default_plugins/Path
      Name: TCPPath
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /curobo/tcp_path
      Enabled: true
      Color: 60; 255; 90
      Line Style: Billboards
      Line Width: 0.012
      Alpha: 1
      Buffer Length: 1
      Offset: {X: 0, Y: 0, Z: 0}
      Pose Style: None
    - Class: rviz_default_plugins/InteractiveMarkers
      Name: PosePicker
      Enabled: true
      Interactive Markers Namespace: /curobo/pose_picker
      Show Axes: false
      Show Descriptions: true
      Show Visual Aids: false
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Name: PickInfo
      Enabled: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /curobo/pick_info
      Value: true
    - Class: rviz_default_plugins/Marker
      Name: Goal
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /curobo/goal
      Enabled: true
    - Class: rviz_default_plugins/MarkerArray
      Name: RobotSpheres
      Namespaces: {}
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /collision_spheres
      Enabled: true
    - Class: rviz_default_plugins/MarkerArray
      Name: Gripper
      Namespaces: {}
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /gripper_viz
      Enabled: true
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: false
      Marker Scale: 0.2
      Show Arrows: false
      Show Axes: true
      Show Names: true
  Global Options:
    Background Color: 40; 40; 42
    Fixed Frame: base_link
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/Interact
      Hide Inactive Objects: true
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 2.4
      Focal Point: {X: 0.35, Y: 0, Z: 0.35}
      Name: Current View
      Pitch: 0.45
      Yaw: 5.6
      Target Frame: base_link
Window Geometry:
  Height: 1000
  Width: 1700
  Displays:
    collapsed: false
